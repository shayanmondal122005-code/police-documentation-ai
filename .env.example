# Create a key at https://console.groq.com/keys. Never commit the real key.
GROQ_API_KEY=

# Optional model overrides (also supported in Streamlit Secrets).
# Audio: whisper-large-v3 or whisper-large-v3-turbo
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Strict JSON reports: openai/gpt-oss-120b or openai/gpt-oss-20b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
