GEMINI_API_KEY=

# Optional model overrides; use compatible audio/JSON Flash models for prompted/report.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
GEMINI_REPORT_MODEL=gemini-3.8-flash
GEMINI_ASR_MODEL=gemini-3.5-transcribe
# Used once after SDK retries exhaust on HTTP 500/502/503. Blank disables fallback.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
